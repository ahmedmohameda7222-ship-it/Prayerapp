# Supabase public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only secret. Prefer the current secret key; the service-role
# variable remains supported for older project setups.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to access the mosque administration area.
ADMIN_EMAILS=

# Used server-side for optional reverse geocoding on the Qibla page.
GEOAPIFY_API_KEY=

# Web Push (generate one VAPID key pair and keep the private key server-side).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional authorization fallback for the prayer-reminder endpoint. Production
# also supports the private Supabase Vault token used by the Supabase Cron job.
CRON_SECRET=
